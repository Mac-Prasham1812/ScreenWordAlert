<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ScreenWord Alert"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:gravity="center"
            android:paddingTop="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Engineered by CodeXen"
            android:textSize="12sp"
            android:textColor="#9E9E9E"
            android:gravity="center"
            android:paddingBottom="16dp"/>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Checking service..."
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:gravity="center"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Target App Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Target Apps"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/selectAppButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select App to Monitor"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monitored Apps (Long press to remove)"
            android:textColor="#666666"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <ListView
            android:id="@+id/targetList"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="#FFFFFF"
            android:divider="#E0E0E0"
            android:dividerHeight="1dp"
            android:layout_marginBottom="16dp"/>

        <!-- Keyword Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keywords to Track"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/keywordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter keyword (e.g. @alert, #urgent)"
            android:inputType="text"
            android:background="@android:drawable/edit_text"
            android:padding="10dp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/addButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Keyword"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tracking Keywords (Long press to delete)"
            android:textColor="#666666"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <ListView
            android:id="@+id/keywordList"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="#FFFFFF"
            android:divider="#E0E0E0"
            android:dividerHeight="1dp"/>

    </LinearLayout>
</ScrollView>